<xml>
  <!--
    Build configuration for the bionic stdio shim that lets Android link
    LuaJIT at API 21.

    hxluajit ships prebuilt Android LuaJIT libraries that reference the
    `stdin`/`stdout`/`stderr` stdio variables. Bionic only exports those from
    API 23 on, while this engine supports API 21, so the final link fails with
    `ld.lld: error: undefined symbol: stdout` (and stdin/stderr). The shim in
    src/phoenix_luajit_bionic_stdio.cpp defines the three variables on top of
    bionic's `__sF` stream array, which has existed since API 1.

    Only Android builds that link LuaJIT (LUA_ALLOWED, i.e. hxluajit is on the
    classpath) compile the translation unit; every other target keeps the
    sources it compiled before this shim existed. The translation unit repeats
    both guards, so a stray hxcpp build cannot pick up Android-only symbols.
  -->
  <pragma once="true" />
  <set name="PHOENIX_LUAJIT_STDIO_DIR" value="${this_dir}" />
  <files id="phoenix_luajit_bionic_stdio">
    <compilervalue name="-I" value="${PHOENIX_LUAJIT_STDIO_DIR}/include/" />
    <!-- hxcpp hashes declared dependencies when reusing cached objects. -->
    <depend name="${PHOENIX_LUAJIT_STDIO_DIR}/include/phoenix_luajit_bionic_stdio.h" />
    <file name="${PHOENIX_LUAJIT_STDIO_DIR}/src/phoenix_luajit_bionic_stdio.cpp" />
  </files>
  <target id="haxe">
    <section if="android">
      <files id="phoenix_luajit_bionic_stdio" />
    </section>
  </target>
</xml>
